# ============================================================
# RAGNIFY Enterprise AI & HR Onboarding Platform Environment Configuration
# ============================================================

# Database Connection (SQLite default for development, or PostgreSQL for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/Task Management
DATABASE_URL=sqlite:///./ragnify.db

# LLM Inference & Multilingual Audio (Groq Cloud)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret
SECRET_KEY=your_super_secret_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional 2FA SMS & WhatsApp Delivery Gateways
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Role-specific 2FA Mobile Number Directory (Defaults provided if unset)
HR_MOBILE_NUMBER=8767920649
MANAGER_MOBILE_NUMBER=9812345678
EMPLOYEE_MOBILE_NUMBER=9765432109
INTERN_MOBILE_NUMBER=9654321098
ADMIN_MOBILE_NUMBER=9988776655

